# Backend API URL (optional in dev because Vite proxies /api to http://localhost:5000)
VITE_API_BASE_URL=/api

# Optional: Google Maps JavaScript API Key (If omitted, client auto-fetches from backend /api/cafes/config)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Client Credentials (Must match backend Supabase Project)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
